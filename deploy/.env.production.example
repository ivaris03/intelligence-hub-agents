# Copy this entire file into the GitHub Production Environment secret
# named PRODUCTION_ENV_FILE. BACKEND_IMAGE and FRONTEND_IMAGE are appended
# automatically by the workflow for every deployment.

SITE_DOMAIN=intelligence.ivaris.top
# This creates an isolated login/database in the PostgreSQL instance shared
# with voice-shopping-agents. Use a long URL-safe value.
INTELLIGENCE_POSTGRES_PASSWORD=replace-with-a-long-random-password

DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.7-flash
QWEN_AGENT_MODEL=qwen3.7-plus
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_THINKING_BUDGET=1024

TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=

STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-a-random-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-secret-key
MINIO_BUCKET=intelligence-hub-agents
MINIO_SECURE=false

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intelligence-hub-agents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

RESEARCH_MAX_SEARCHES=4
RESEARCH_TIMEOUT_SECONDS=120
SLIDES_MAX_PAGES=15
