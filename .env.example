# Server
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intelligence_hub_agents

# Alibaba Cloud Model Studio (server-side only)
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.7-flash
QWEN_AGENT_MODEL=qwen3.7-plus
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_THINKING_BUDGET=1024

# LangSmith tracing (server-side only)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intelligence-hub-agents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Search and storage
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_KEY=
STORAGE_BACKEND=minio
STORAGE_PATH=../storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=intelligence-hub-agents
MINIO_SECURE=false

# MVP limits
MAX_UPLOAD_BYTES=20971520
MAX_FILES_PER_REQUEST=3
MAX_IMAGE_PIXELS=24000000
DOCUMENT_INLINE_CHARS=12000
DOCUMENT_CHUNK_CHARS=1200
DOCUMENT_CHUNK_OVERLAP=150
RECENT_MESSAGE_LIMIT=12
MEMORY_MAX_ITEMS=5
MEMORY_CONTEXT_CHARS=1500
RESEARCH_MAX_SEARCHES=4
RESEARCH_TIMEOUT_SECONDS=120
SLIDES_MAX_PAGES=15
